+# filmes) e native/runtime/ (os hooks do runtime: wotm_live.inc e os .inc que ele inclui, wotm_overrides.cpp, o VU0 nativo).
+# O microcodigo do VU0 traduzido (wotm_vu0_native.gen.inc, gerado por tools/vu0native.py do repo a partir do ELF; codigo do jogo,
+# fora de qualquer repo) fica em ${CMAKE_BINARY_DIR}/wotm_gen (build_runtime.ps1 o grava la).
+set(WOTM_NATIVE_DIR "" CACHE PATH "WoTM native/ directory")
+if(NOT WOTM_NATIVE_DIR)
