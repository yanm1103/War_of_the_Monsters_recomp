+EeScheduler::EeScheduler(PS2Runtime &runtime)
+    : m_runtime(runtime)
+{
+}
+
+EeScheduler::~EeScheduler()
+{
+    requestStop();
+    if (G.timer.joinable())
+        G.timer.join();
+}
+
+void EeScheduler::reset(uint8_t *rdram, const R5900Context &mainContext)
+{
+    m_executorThread = std::this_thread::get_id();
+    m_rdram = rdram;
+    m_threads.clear();
+    m_semaphores.clear();
+    m_eventFlags.clear();
+    m_alarms.clear();
+    m_intcHandlers.clear();
+    m_dmacHandlers.clear();
+    m_nextThreadId = kFirstThreadId;
+    m_nextSemaphoreId = 1;
+    m_nextEventFlagId = 1;
+    m_nextIntcHandlerId = 1;
+    m_nextDmacHandlerId = 1;
+    m_intcHeadOrder = 0;
+    m_intcTailOrder = 1000;
+    m_dmacHeadOrder = 0;
+    m_dmacTailOrder = 1000;
+    m_enabledIntcMask = 0xFFFFFFFFu;
+    m_enabledDmacMask = 0xFFFFFFFFu;
+    m_insideInterrupt = false;
+    m_eeCycle = 0u;
+    m_stopRequested.store(false, std::memory_order_release);
+    m_checkpointPending.store(false, std::memory_order_release);
+    {
+        std::lock_guard lock(m_eventMutex);
+        m_events.clear();
+        m_pendingInvocations.clear();
+        G.vblankDue = 0;
+        G.waiting = false;
+        G.stallOpen = false;
+    }
+    m_invocationSequence = 0;
+    m_invocationStackTops.clear();
+    m_vsyncTick = 0;
+    m_vsyncFlagAddress = 0;
+    m_vsyncTickAddress = 0;
+    m_gsVSyncCallback = 0;
+    m_gsVSyncCallbackGp = 0;
+    m_gsVSyncCallbackSp = 0;
+    m_runtime.memory().gs().vsyncTick.store(0u, std::memory_order_release);
+    G.deliverDepth = 0;
+    G.mainDormant = false;
+    G.sleeping = false;
+    G.releaseWait = false;
+    G.external.clear();
+    G.publishedTick = 0;
+
+    GuestThread main{};
+    main.id = kMainThreadId;
+    main.context = mainContext;
+    main.entry = mainContext.pc;
+    main.gp = getRegU32(&mainContext, 28);
+    main.status = EeThreadStatus::Running;
+    main.invocations.reserve(64u);
+    GuestThread &stored = m_threads.emplace(main.id, std::move(main)).first->second;
+    m_currentThreadId = kMainThreadId;
+    G.active = &stored.context;
+    publishSnapshot();
+}
+
+void EeScheduler::run()
+{
+    assertExecutor();
+    m_running.store(true, std::memory_order_release);
+    {
+        std::lock_guard lock(m_eventMutex);
+        G.vblankDue = 0;
+        G.next = Clock::now() + kVBlankPeriod;
+    }
+    // Relogio do vblank: grade fixa no host. Depois de uma travada de mais de 4 vblanks a grade recomeca de agora, e o EE aplica
+    // so um (wotmService), em vez de vencer os atrasados de uma vez.
+    G.timer = std::thread([this]()
+                          {
+        std::unique_lock lock(m_eventMutex);
+        while (!m_stopRequested.load(std::memory_order_acquire))
+        {
+            const Clock::time_point target = G.next;
+            G.timerCv.wait_until(lock, target, [this]() { return m_stopRequested.load(std::memory_order_acquire); });
+            if (m_stopRequested.load(std::memory_order_acquire))
+                break;
+            const Clock::time_point now = Clock::now();
+            if (now < G.next)   // acordou cedo, ou a pausa (shiftHostDeadlines) empurrou o prazo
+                continue;
+            if (now - G.next > 4 * kVBlankPeriod)
+                G.next = now;
+            G.next += kVBlankPeriod;
+            ++G.vblankDue;
+            // WOTM_FIELDLOG: tres vblanks sem o EE chegar a um checkpoint nem esperar = thread do jogo presa em alguma chamada
+            if (g_wotmCycleProf && !G.waiting && G.vblankDue >= 3u && !G.stallOpen)
+            {
+                G.stallOpen = true;
+                G.stallStart = now - 2 * kVBlankPeriod;
+                const R5900Context *c = g_wotmLiveCtx.load(std::memory_order_relaxed);
+                G.stallPc = c ? c->pc : 0u;
+                G.stallRa = c ? getRegU32(c, 31) : 0u;
+            }
+            m_checkpointPending.store(true, std::memory_order_release);
+            m_eventCv.notify_all();
+        } });
+
+    GuestThread &main = m_threads.at(kMainThreadId);
+    while (!m_stopRequested.load(std::memory_order_acquire))
+    {
+        if (G.mainDormant)
+        {
+            wotmIdleWait();
+            wotmService(true);
+            continue;
+        }
+        if (m_checkpointPending.load(std::memory_order_acquire))
+        {
+            wotmService(true);
+            if (m_stopRequested.load(std::memory_order_acquire))
+                break;
+        }
+        R5900Context &context = main.context;
+        G.active = &context;
+        if (context.pc == 0u || !m_runtime.hasFunction(context.pc))
+        {
+            if (context.pc != 0u)
+                m_runtime.reportMissingFunction(m_rdram, &context, context.pc, context.pc, PS2Runtime::GuestBranchKind::DirectJump,
+                                                "EE (wotm)");
+            std::fprintf(stderr, "[ee] a thread principal parou (pc=0x%x): o EE so atende vblanks daqui em diante\n", context.pc);
+            G.mainDormant = true;
+            main.status = EeThreadStatus::Dormant;
+            publishSnapshot();
+            continue;
+        }
+        PS2Runtime::RecompiledFunction function = m_runtime.lookupFunction(context.pc);
+        try
+        {
+            m_guestExecuting.store(true, std::memory_order_release);
+            function(m_rdram, &context, &m_runtime);
+            m_guestExecuting.store(false, std::memory_order_release);
+        }
+        catch (const EeDispatcherTransfer &)
+        {
+            m_guestExecuting.store(false, std::memory_order_release);
+        }
+        catch (...)
+        {
+            m_guestExecuting.store(false, std::memory_order_release);
+            m_running.store(false, std::memory_order_release);
+            requestStop();
+            if (G.timer.joinable())
+                G.timer.join();
+            publishSnapshot();
+            throw;
+        }
+    }
+
+    requestStop();
+    if (G.timer.joinable())
+        G.timer.join();
+    m_guestExecuting.store(false, std::memory_order_release);
+    m_running.store(false, std::memory_order_release);
+    copyMainContextToRuntime();
+    publishSnapshot();
+}
+
+void EeScheduler::requestStop()
+{
+    m_stopRequested.store(true, std::memory_order_release);
+    m_checkpointPending.store(true, std::memory_order_release);
+    {
+        std::lock_guard lock(m_eventMutex);
+    }
+    m_eventCv.notify_all();
+    G.timerCv.notify_all();
+}
+
+void EeScheduler::postEvent(EeEvent event)
+{
+    if (event.type == EeEventType::Stop)
+    {
+        requestStop();
+        return;
+    }
+    {
+        std::lock_guard lock(m_eventMutex);
+        m_events.push_back(event);
+        m_checkpointPending.store(true, std::memory_order_release);
+    }
+    m_eventCv.notify_all();
+}
+
+// Chamado pelo codigo gerado em toda cabeca de laco e toda chamada (27 a 47 mil vezes por quadro): sem relogio, sem fila.
+bool EeScheduler::checkpointDue(uint32_t cycles) noexcept
+{
+    const uint64_t elapsed = std::max<uint32_t>(1u, cycles);
+    m_eeCycle += elapsed;
+    g_wotmEeCycle = m_eeCycle;
+    const R5900Context *c = G.active;
+    if (g_wotmFreeSpinPc != 0u && c && c->pc == g_wotmFreeSpinPc)
+    {
+        for (const uint32_t addr : g_wotmFreeSpinZero)
+            if (addr && m_rdram)
+                std::memset(m_rdram + (addr & 0x1FFFFFFFu), 0, 4);
+    }
+    if (g_wotmCycleProf && c)
+        wotmProfAdd(c->pc, elapsed);
+    if (!m_checkpointPending.load(std::memory_order_acquire))
+        return false;
+    if (m_stopRequested.load(std::memory_order_acquire))
+        return true;
+    if (G.deliverDepth > 0)   // dentro de uma interrupcao: o resto espera ela voltar
+        return false;
+    try
+    {
+        wotmService(true);
+    }
+    catch (const std::exception &e)
+    {
+        std::fprintf(stderr, "[ee] erro numa interrupcao/callback do jogo: %s; parando\n", e.what());
+        requestStop();
+    }
+    catch (...)
+    {
+        std::fprintf(stderr, "[ee] erro numa interrupcao/callback do jogo; parando\n");
+        requestStop();
+    }
+    return m_stopRequested.load(std::memory_order_acquire);
+}
+
+void EeScheduler::accountCycles(uint32_t cycles) noexcept
+{
+    m_eeCycle += std::max<uint32_t>(1u, cycles);
+    g_wotmEeCycle = m_eeCycle;
+}
+
+bool EeScheduler::isExecutingGuest() const noexcept
+{
+    return m_guestExecuting.load(std::memory_order_acquire);
+}
+
+// ---- atencao: vblank, eventos de outras threads, interrupcoes pendentes ----
+
+void EeScheduler::wotmService(bool deliver)
+{
+    uint32_t due = 0;
+    std::deque<EeEvent> events;
+    bool stallOpen = false;
+    Clock::time_point stallStart{};
+    uint32_t stallPc = 0, stallRa = 0;
+    {
+        std::lock_guard lock(m_eventMutex);
+        due = G.vblankDue;
+        G.vblankDue = 0;
+        events.swap(m_events);
+        m_checkpointPending.store(m_stopRequested.load(std::memory_order_acquire), std::memory_order_release);
+        if (G.stallOpen)
+        {
+            stallOpen = true;
+            stallStart = G.stallStart;
+            stallPc = G.stallPc;
+            stallRa = G.stallRa;
+            G.stallOpen = false;
+        }
+    }
+    if (stallOpen)
+        std::fprintf(stderr, "[stall] %.1f ms sem checkpoint: pc=%06x ra=%06x vsync=%llu\n",
+                     std::chrono::duration<double, std::milli>(Clock::now() - stallStart).count(), stallPc, stallRa,
+                     static_cast<unsigned long long>(m_vsyncTick));
+    if (due > 4u)
+        due = 1u;
+    for (uint32_t i = 0; i < due; ++i)
+        wotmVBlank();
+    for (const EeEvent &event : events)
+    {
+        if (event.type == EeEventType::Stop)
+            requestStop();
+        else if (event.type == EeEventType::ExternalWake)
+            completeExternalWait(event.id, event.value, KE_OK);
+    }
+    if (deliver && G.deliverDepth == 0)
+        wotmDeliverPending();
+    if (!m_pendingInvocations.empty())
+        m_checkpointPending.store(true, std::memory_order_release);
+}
+
+void EeScheduler::wotmVBlank()
+{
+    ++m_vsyncTick;
+    m_runtime.memory().gs().vsyncTick.store(m_vsyncTick, std::memory_order_release);
+    if ((m_vsyncTick & 1u) != 0u)
+        m_runtime.memory().gs().csr.fetch_or(0x2000ull, std::memory_order_acq_rel);
+    else
+        m_runtime.memory().gs().csr.fetch_and(~0x2000ull, std::memory_order_acq_rel);
+    writeGuestU32(m_vsyncFlagAddress, 1u);
+    if (m_vsyncTickAddress != 0u)
+    {
+        const uint32_t physical = m_vsyncTickAddress & 0x1FFFFFFFu;
+        if (m_rdram && physical <= PS2_RAM_SIZE - sizeof(uint64_t))
+            std::memcpy(m_rdram + physical, &m_vsyncTick, sizeof(m_vsyncTick));
+    }
+    m_vsyncFlagAddress = 0u;
+    m_vsyncTickAddress = 0u;
+    if (m_gsVSyncCallback != 0u && m_runtime.hasFunction(m_gsVSyncCallback))
+    {
+        GuestInvocation invocation{};
+        invocation.kind = GuestInvocationKind::GsCallback;
+        invocation.context.pc = m_gsVSyncCallback;
+        SET_GPR_U32(&invocation.context, 4, static_cast<uint32_t>(m_vsyncTick));
+        SET_GPR_U32(&invocation.context, 28, m_gsVSyncCallbackGp);
+        SET_GPR_U32(&invocation.context, 29, 0u);
+        SET_GPR_U32(&invocation.context, 31, 0u);
+        queueInvocation(std::move(invocation));
+    }
+    // inicio e fim do vblank juntos: nenhum handler de INTC registrado no WotM (passo 8)
+    dispatchIrq(false, 2u);
+    dispatchIrq(false, 3u);
+
+    if (G.active)
+        publishDebugContext(*G.active);
+    if (m_vsyncTick - G.publishedTick >= 8u)
+    {
+        G.publishedTick = m_vsyncTick;
+        copyMainContextToRuntime();
+        publishSnapshot();
+    }
+}
+
+void EeScheduler::wotmDeliverPending()
+{
+    GuestThread &main = m_threads.at(kMainThreadId);
+    while (!m_pendingInvocations.empty() && !m_stopRequested.load(std::memory_order_acquire))
+    {
+        if (main.invocations.size() >= kMaxInvocationDepth)
+        {
+            warnUnsupported("interrupcao aninhada fundo demais", static_cast<int>(main.invocations.size()));
+            m_pendingInvocations.clear();
+            break;
+        }
+        GuestInvocation invocation = std::move(m_pendingInvocations.front());
+        m_pendingInvocations.pop_front();
+        if (getRegU32(&invocation.context, 29) == 0u)
+            SET_GPR_U32(&invocation.context, 29, invocationStackTop());
+        const size_t base = main.invocations.size();
+        main.invocations.push_back(std::move(invocation));
+        ++G.deliverDepth;
+        wotmRunInvocations(base);
+        --G.deliverDepth;
+    }
+}
+
+// Roda as invocacoes acima de baseDepth ate todas voltarem (pc 0), como o laco do escalonador fazia, mas aninhado.
+void EeScheduler::wotmRunInvocations(size_t baseDepth)
+{
+    GuestThread &main = m_threads.at(kMainThreadId);
+    while (main.invocations.size() > baseDepth)
+    {
+        GuestInvocation &top = main.invocations.back();
+        R5900Context &context = top.context;
+        G.active = &context;
+        if (context.pc == 0u || m_stopRequested.load(std::memory_order_acquire))
+        {
+            GuestInvocation done = std::move(top);
+            main.invocations.pop_back();
+            G.active = &main.activeContext();
+            if (done.onComplete && !m_stopRequested.load(std::memory_order_acquire))
+            {
+                try
+                {
+                    done.onComplete(done.context, main.activeContext());
+                }
+                catch (const EeDispatcherTransfer &)
+                {
+                }
+            }
+            continue;
+        }
+        if (!m_runtime.hasFunction(context.pc))
+        {
+            m_runtime.reportMissingFunction(m_rdram, &context, context.pc, context.pc, PS2Runtime::GuestBranchKind::DirectJump,
+                                            "EE invocacao (wotm)");
+            context.pc = 0u;
+            continue;
+        }
+        PS2Runtime::RecompiledFunction function = m_runtime.lookupFunction(context.pc);
+        const bool wasInside = m_insideInterrupt;
+        m_insideInterrupt = top.kind == GuestInvocationKind::Interrupt;
+        try
+        {
+            function(m_rdram, &context, &m_runtime);
+        }
+        catch (const EeDispatcherTransfer &)
+        {
+        }
+        m_insideInterrupt = wasInside;
+    }
+    G.active = &main.activeContext();
+}
+
+void EeScheduler::wotmIdleWait()
+{
+    const auto t0 = Clock::now();
+    g_wotmIdleCalls.fetch_add(1, std::memory_order_relaxed);
+    {
+        std::unique_lock lock(m_eventMutex);
+        G.waiting = true;
+        m_eventCv.wait(lock, [this]()
+                       { return G.vblankDue > 0u || !m_events.empty() || m_stopRequested.load(std::memory_order_acquire) ||
+                                (G.deliverDepth == 0 && !m_pendingInvocations.empty()); });
+        G.waiting = false;
+    }
+    const auto us = std::chrono::duration_cast<std::chrono::microseconds>(Clock::now() - t0).count();
+    g_wotmIdleUs.fetch_add(static_cast<unsigned long long>(us), std::memory_order_relaxed);
+    const uint64_t cycles = static_cast<uint64_t>(us) * kEeClockHz / 1000000ull;
+    g_wotmIdleCycles += cycles;
+    m_eeCycle += cycles;
+    g_wotmEeCycle = m_eeCycle;
+}
+
+// Espera no lugar: dorme ate a atencao, aplica (vblank, eventos, interrupcoes se nao estiver dentro de uma) e confere de novo.
+template <typename Done>
+static void wotmWaitUntil(EeScheduler &ee, GuestThread &main, EeWaitReason reason, Done done,
+                          void (EeScheduler::*idle)(), void (EeScheduler::*service)(bool), const std::atomic<bool> &stop)
+{
+    const EeThreadStatus status = main.status;
+    main.status = EeThreadStatus::Waiting;
+    main.wait.reason = reason;
+    while (!done() && !stop.load(std::memory_order_acquire))
+    {
+        (ee.*idle)();
+        (ee.*service)(G.deliverDepth == 0);
+    }
+    main.wait.reason = EeWaitReason::None;
+    main.status = status;
+}
+
+int EeScheduler::waitVSyncHere(uint64_t afterTick, int fixedResult)
+{
+    assertExecutor();
+    if (G.deliverDepth == 0 && m_checkpointPending.load(std::memory_order_acquire))
+        wotmService(true);
+    wotmWaitUntil(*this, m_threads.at(kMainThreadId), EeWaitReason::VSync,
+                  [this, afterTick]() { return m_vsyncTick > afterTick; },
+                  &EeScheduler::wotmIdleWait, &EeScheduler::wotmService, m_stopRequested);
+    return fixedResult >= 0 ? fixedResult : static_cast<int>((m_vsyncTick - 1u) & 1u);
+}
+
+[[noreturn]] void EeScheduler::waitVSync(uint64_t afterTick, int fixedResult, std::function<void(R5900Context &)> completion)
+{
+    const int result = waitVSyncHere(afterTick, fixedResult);
+    R5900Context &context = *currentContext();
+    setReturnS32(&context, result);
+    if (completion)
+        completion(context);
+    throw EeDispatcherTransfer{};
+}
+
+void EeScheduler::completeVSync(uint64_t)
+{
+}
+
+void EeScheduler::completeExternalWait(uint32_t type, uint64_t token, int result)
+{
+    for (ExternalWait &wait : G.external)
+        if (!wait.done && wait.type == type && wait.token == token)
+        {
+            wait.done = true;
+            wait.result = result;
+        }
+}
+
+[[noreturn]] void EeScheduler::waitExternal(EeWaitReason reason, uint32_t type, uint64_t token,
+                                            std::function<void(R5900Context &)> completion)
+{
+    assertExecutor();
+    const size_t slot = G.external.size();
+    G.external.push_back(ExternalWait{type, token, false, 0});
+    wotmWaitUntil(*this, m_threads.at(kMainThreadId), reason, [slot]() { return G.external[slot].done; },
+                  &EeScheduler::wotmIdleWait, &EeScheduler::wotmService, m_stopRequested);
+    const int result = G.external[slot].result;
+    G.external.resize(slot);
+    R5900Context &context = *currentContext();
+    setReturnS32(&context, result);
+    if (completion)
+        completion(context);
+    throw EeDispatcherTransfer{};
+}
+
+// ---- threads: so a principal ----
+
+void EeScheduler::setupCurrentThread(uint32_t stack, uint32_t stackSize, uint32_t gp)
+{
+    GuestThread *target = currentThread();
+    if (!target)
+        return;
+    target->stack = stack;
+    target->stackSize = stackSize;
+    target->gp = gp;
+    publishSnapshot();
+}
+
+int EeScheduler::createThread(const EeThreadCreateParams &params)
+{
+    if (params.priority < 1 || params.priority >= kPriorityCount)
+        return KE_ILLEGAL_PRIORITY;
+    const int id = allocateThreadId();
+    if (id == 0)
+        return KE_ERROR;
+    warnUnsupported("CreateThread (registrada, nunca roda)", id);
+    GuestThread thread{};
+    thread.id = id;
+    thread.entry = params.entry;
+    thread.stack = params.stack;
+    thread.stackSize = params.stackSize;
+    thread.gp = params.gp;
+    thread.attr = params.attr;
+    thread.option = params.option;
+    thread.initialPriority = params.priority;
+    thread.currentPriority = params.priority;
+    thread.status = EeThreadStatus::Dormant;
+    m_threads.emplace(id, std::move(thread));
+    publishSnapshot();
+    return id;
+}
+
+int EeScheduler::deleteThread(int id, uint32_t &ownedStack)
+{
+    ownedStack = 0;
+    if (id <= kMainThreadId)
+        return KE_ILLEGAL_THID;
+    auto it = m_threads.find(id);
+    if (it == m_threads.end())
+        return KE_UNKNOWN_THID;
+    if (it->second.ownsStack)
+        ownedStack = it->second.stack;
+    m_threads.erase(it);
+    publishSnapshot();
+    return KE_OK;
+}
+
+int EeScheduler::startThread(int id, uint32_t, const R5900Context &, bool)
+{
+    if (!thread(id))
+        return KE_UNKNOWN_THID;
+    warnUnsupported("StartThread", id);
+    return KE_ERROR;
+}
+
+[[noreturn]] void EeScheduler::exitCurrent(bool)
+{
+    std::fprintf(stderr, "[ee] ExitThread na thread principal: o EE so atende vblanks daqui em diante\n");
+    G.mainDormant = true;
+    if (GuestThread *main = thread(kMainThreadId))
+    {
+        main->status = EeThreadStatus::Dormant;
+        main->invocations.clear();
+    }
+    publishSnapshot();
+    throw EeDispatcherTransfer{};
+}
+
+int EeScheduler::terminateThread(int id, uint32_t &ownedStack, bool)
+{
+    ownedStack = 0;
+    if (id == 0 || id == kMainThreadId)
+        return KE_ILLEGAL_THID;
+    return thread(id) ? KE_DORMANT : KE_UNKNOWN_THID;
+}
+
+int EeScheduler::suspendThread(int id, bool)
+{
+    if (id == 0 || id == kMainThreadId)
+    {
+        warnUnsupported("SuspendThread da principal", id);
+        return KE_ILLEGAL_THID;
+    }
+    return thread(id) ? KE_DORMANT : KE_UNKNOWN_THID;
+}
+
+int EeScheduler::resumeThread(int id, bool)
+{
+    if (id == 0 || id == kMainThreadId)
+        return KE_ILLEGAL_THID;
+    return thread(id) ? KE_NOT_SUSPEND : KE_UNKNOWN_THID;
+}
+
+void EeScheduler::sleepCurrent()
+{
+    GuestThread &main = m_threads.at(kMainThreadId);
+    if (main.wakeupCount == 0u)
+    {
+        G.sleeping = true;
+        G.releaseWait = false;
+        wotmWaitUntil(*this, main, EeWaitReason::Sleep, [&main]() { return main.wakeupCount != 0u || G.releaseWait; },
+                      &EeScheduler::wotmIdleWait, &EeScheduler::wotmService, m_stopRequested);
+        G.sleeping = false;
+        if (G.releaseWait)
+        {
+            G.releaseWait = false;
+            setReturnS32(currentContext(), KE_RELEASE_WAIT);
+            return;
+        }
+    }
+    if (main.wakeupCount != 0u)
+        --main.wakeupCount;
+    setReturnS32(currentContext(), KE_OK);
+}
+
+int EeScheduler::wakeupThread(int id, bool)
+{
+    GuestThread *target = thread(id);
+    if (!target)
+        return id == 0 ? KE_ILLEGAL_THID : KE_UNKNOWN_THID;
+    if (id == kMainThreadId && !G.sleeping && G.deliverDepth == 0)
+        return KE_ILLEGAL_THID;   // a propria thread
+    if (target->status == EeThreadStatus::Dormant)
+        return KE_DORMANT;
+    ++target->wakeupCount;
+    return KE_OK;
+}
+
+int EeScheduler::cancelWakeup(int id)
+{
+    if (id == 0)
+        id = kMainThreadId;
+    GuestThread *target = thread(id);
+    if (!target)
+        return KE_UNKNOWN_THID;
+    const int old = static_cast<int>(target->wakeupCount);
+    target->wakeupCount = 0;
+    return old;
+}
+
+int EeScheduler::changePriority(int id, int priority, bool, int &oldPriority)
+{
+    if (priority < 1 || priority >= kPriorityCount)
+        return KE_ILLEGAL_PRIORITY;
+    if (id == 0)
+        id = kMainThreadId;
+    GuestThread *target = thread(id);
+    if (!target)
+        return KE_UNKNOWN_THID;
+    oldPriority = target->currentPriority;
+    target->currentPriority = priority;
+    return KE_OK;
+}
+
+int EeScheduler::rotateReadyQueue(int priority, bool)
+{
+    return (priority < 0 || priority >= kPriorityCount) ? KE_ILLEGAL_PRIORITY : KE_OK;
+}
+
+int EeScheduler::releaseWait(int id, bool)
+{
+    if (id == 0)
+        return KE_ILLEGAL_THID;
+    GuestThread *target = thread(id);
+    if (!target)
+        return KE_UNKNOWN_THID;
+    if (id != kMainThreadId || target->status != EeThreadStatus::Waiting)
+        return KE_NOT_WAIT;
+    G.releaseWait = true;
+    return KE_OK;
+}
