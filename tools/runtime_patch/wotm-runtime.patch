diff --git a/ps2xRuntime/src/lib/wotm_live.inc b/ps2xRuntime/src/lib/wotm_live.inc
new file mode 100644
index 0000000..9850324
--- /dev/null
+++ b/ps2xRuntime/src/lib/wotm_live.inc
@@ -0,0 +1,134 @@
+// wotm_live.inc: desenho nativo ao vivo (incluido por wotm_scene.inc, no escopo global de ps2_runtime.cpp).
+// Usa native/wotm_native.hpp (do repo WoTM; passe -DWOTM_NATIVE_DIR=<WoTM>/native ao CMake). Sem o header, nao faz nada.
+#if __has_include("wotm_native.hpp")
+#include "wotm_native.hpp"
+#include <filesystem>
+#define WOTM_HAVE_NATIVE 1
+
+namespace wotm_live
+{
+// Diagnostico de queda: sem windows.h (conflita com o raylib), espelha so o que o filtro precisa.
+struct ExcRecord
+{
+    unsigned long code, flags;
+    ExcRecord *next;
+    void *address;
+    unsigned long nparams;
+    unsigned long long info[15];
+};
+struct ExcPointers
+{
+    ExcRecord *rec;
+    void *ctx;
+};
+extern "C" __declspec(dllimport) void *__stdcall SetUnhandledExceptionFilter(long(__stdcall *)(ExcPointers *));
+extern "C" __declspec(dllimport) void *__stdcall GetModuleHandleA(const char *);
+inline const char *g_stage = "idle";   // etapa da camada nativa em andamento (para localizar a queda)
+inline long __stdcall crashFilter(ExcPointers *e)
+{
+    const char *base = static_cast<const char *>(GetModuleHandleA(nullptr));
+    std::fprintf(stderr, "[CRASH] code=0x%08lx addr=%p (exe+0x%llx) stage=%s", e->rec->code, e->rec->address,
+                 (unsigned long long)(static_cast<const char *>(e->rec->address) - base), g_stage);
+    if (e->rec->code == 0xC0000005)
+        std::fprintf(stderr, " acesso=%s endereco=0x%llx", e->rec->info[0] == 1 ? "escrita" : (e->rec->info[0] == 8 ? "execucao" : "leitura"), e->rec->info[1]);
+    std::fprintf(stderr, "\n");
+    std::fflush(stderr);
+    return 0; // EXCEPTION_CONTINUE_SEARCH
+}
+struct State
+{
+    wotm::Scene scene;
+    RenderTexture2D rt{};
+    uint32_t levelSig = 0;
+    bool rtxChosen = false;
+    std::string rtxPath;
+    long frame = 0;
+};
+
+inline uint32_t levelSignature(const wotm::Ram &ram)
+{
+    uint32_t h = ram.u32(wotm::addr::tempVramTexAddr) * 2654435761u;
+    for (uint32_t a = 0xA00000; a < 0xA00400; a += 4)
+        h = (h ^ ram.u32(a)) * 16777619u;
+    return h;
+}
+
+} // namespace wotm_live
+
+// Desenha a fase lida da RAM (sem VU1/GS) por cima do quadro; devolve falso (e nao desenha) quando nao ha fase carregada.
+static bool wotmDrawNative(const uint8_t *rdram)
+{
+    static wotm_live::State S;
+    static bool filterInstalled = false;
+    if (!filterInstalled)
+    {
+        filterInstalled = true;
+        wotm_live::SetUnhandledExceptionFilter(wotm_live::crashFilter);
+    }
+    const wotm::Ram ram{rdram, PS2_RAM_SIZE};
+    const uint32_t wc = ram.u32(wotm::addr::world);
+    if (!ram.ok(wc, 0x40) || !ram.ok(ram.u32(wc)))
+        return false;
+
+    const uint32_t sig = wotm_live::levelSignature(ram);
+    if (sig != S.levelSig)
+    {
+        S.scene.invalidate();
+        S.levelSig = sig;
+        S.rtxChosen = false;
+    }
+    wotm_live::g_stage = "collect";
+    S.scene.collect(ram);
+    if (S.scene.items.size() < 20)
+        return false;
+    {
+        // nivel + monstros: nomes e bases das paletas vem de fileStatus (idempotente; refaz so quando mudam)
+        std::string log;
+        wotm_live::g_stage = "loadResources";
+        S.rtxChosen = S.scene.loadResources(ram, "", &log);
+        if (!log.empty() && log != S.rtxPath)
+        {
+            S.rtxPath = log;
+            std::fprintf(stderr, "[native] recursos: %s\n", log.c_str());
+        }
+    }
+
+    const wotm::GameCamera gc = wotm::readGameCamera(ram, 0);
+    if (!gc.ok)
+        return false;
+
+    const int RW = 960, RH = 720;
+    if (S.rt.id == 0)
+        S.rt = LoadRenderTexture(RW, RH);
+
+    BeginTextureMode(S.rt);
+    ClearBackground(Color{30, 40, 60, 255});
+    rlSetClipPlanes(0.5, 30000.0);
+    Camera3D c3{};
+    c3.position = {gc.pos[0], gc.pos[1], gc.pos[2]};
+    c3.target = {gc.pos[0] + gc.fwd[0], gc.pos[1] + gc.fwd[1], gc.pos[2] + gc.fwd[2]};
+    c3.up = {gc.up[0], gc.up[1], gc.up[2]};
+    c3.fovy = gc.fovy;
+    c3.projection = CAMERA_PERSPECTIVE;
+    BeginMode3D(c3);
+    wotm_live::g_stage = "draw";
+    S.scene.draw(ram, false);
+    wotm_live::g_stage = "idle";
+    EndMode3D();
+    EndTextureMode();
+
+    // letterbox 4:3 na janela
+    const float sw = static_cast<float>(GetScreenWidth()), sh = static_cast<float>(GetScreenHeight());
+    const float k = std::min(sw / RW, sh / RH);
+    const Rectangle src{0.f, 0.f, static_cast<float>(RW), -static_cast<float>(RH)};
+    const Rectangle dst{(sw - RW * k) * 0.5f, (sh - RH * k) * 0.5f, RW * k, RH * k};
+    DrawTexturePro(S.rt.texture, src, dst, Vector2{0.f, 0.f}, 0.f, WHITE);
+
+    if (++S.frame % 300 == 0 && std::getenv("PS2X_STATS"))
+        std::fprintf(stderr, "[native] frame %ld itens=%zu ceu=%zu nos=%u rtx=%s\n", S.frame, S.scene.items.size(), S.scene.sky.size(),
+                     S.scene.visited, S.rtxPath.c_str());
+    return true;
+}
+#else
+static bool wotmDrawNative(const uint8_t *) { return false; }
+#endif
diff --git a/ps2xRuntime/src/lib/wotm_scene.inc b/ps2xRuntime/src/lib/wotm_scene.inc
new file mode 100644
index 0000000..cda24a7
--- /dev/null
+++ b/ps2xRuntime/src/lib/wotm_scene.inc
@@ -0,0 +1,159 @@
+// wotm_scene.inc (incluido por ps2_runtime.cpp; raylib e ps2_runtime.h ja estao incluidos)
+#include <cctype>
+#include "wotm_live.inc"
+namespace wotm_scene_ns
+{
+const uint8_t *g_rd = nullptr;
+
+inline bool okAddr(uint32_t a) { return a >= 0x00100000u && a < 0x01F00000u; }
+inline uint32_t u32(uint32_t a) { uint32_t v; std::memcpy(&v, g_rd + a, 4); return v; }
+inline uint16_t u16(uint32_t a) { uint16_t v; std::memcpy(&v, g_rd + a, 2); return v; }
+inline uint8_t u8(uint32_t a) { return g_rd[a]; }
+inline float f32(uint32_t a) { float v; std::memcpy(&v, g_rd + a, 4); return v; }
+
+enum Op { OBJECT = 0, GROUP = 1, LOD = 2, TRANSLATE = 3, ROTATE = 4, SWITCH = 6, SCALE = 30 };
+
+struct Pt { float x, y, z, r; uint32_t node; int src; };
+
+struct Walker
+{
+    std::vector<Pt> pts;
+    int src = 0;
+    uint32_t perSrc[4] = {};
+    uint32_t visited = 0, byOp[64] = {};
+    uint32_t seen[8192];
+    uint32_t nseen = 0;
+
+    bool already(uint32_t n)
+    {
+        for (uint32_t i = 0; i < nseen; ++i) if (seen[i] == n) return true;
+        if (nseen < 8192) seen[nseen++] = n;
+        return false;
+    }
+
+    void kids(uint32_t arr, uint32_t n, float x, float y, float z, int depth)
+    {
+        if (n > 512) n = 512;
+        for (uint32_t i = 0; i < n; ++i)
+        {
+            uint32_t c = u32(arr + 4 * i);
+            if (okAddr(c)) walk(c, x, y, z, depth + 1);
+        }
+    }
+
+    void walk(uint32_t node, float x, float y, float z, int depth)
+    {
+        if (depth > 48 || visited > 60000 || !okAddr(node)) return;
+        if (already(node)) return;
+        ++visited;
+        const uint32_t op = u32(node) & 0x3Fu;
+        ++byOp[op & 63];
+        switch (op)
+        {
+        case OBJECT:
+        {
+            float r2 = f32(node + 8);
+            pts.push_back({x, y, z, (r2 > 0 && r2 < 1e12f) ? std::sqrt(r2) : 0.f, node, src});
+            ++perSrc[src & 3];
+            break;
+        }
+        case GROUP: kids(node + 0x20, u16(node + 8), x, y, z, depth); break;
+        case TRANSLATE:
+            kids(node + 0x1C, u32(node + 8), x + f32(node + 0x10), y + f32(node + 0x14), z + f32(node + 0x18), depth);
+            break;
+        case ROTATE: kids(node + 0x50, u32(node + 8), x, y, z, depth); break;       // rotacao ignorada neste marco
+        case SCALE: kids(node + 0x2C, u32(node + 8), x, y, z, depth); break;        // escala ignorada neste marco
+        case SWITCH:
+        {
+            uint32_t which = u8(node + 8), n = u8(node + 0xB);
+            if (which < n) { uint32_t c = u32(node + 0xC + 4 * which); if (okAddr(c)) walk(c, x, y, z, depth + 1); }
+            break;
+        }
+        case LOD:
+        {
+            uint32_t n = u32(node + 4);
+            if (n > 0 && n < 16) { uint32_t c = u32(node + 0x20 + 8); if (okAddr(c)) walk(c, x, y, z, depth + 1); } // lod mais detalhado
+            break;
+        }
+        default: break; // nos de colisao, luz, particulas, animacao... (proximos marcos)
+        }
+    }
+};
+} // namespace
+using namespace wotm_scene_ns;
+
+static void wotmDrawScene(const uint8_t *rdram)
+{
+    static long frame = 0;
+    ++frame;
+    g_rd = rdram;
+    if (!g_rd) return;
+    {
+        // Sem VU1 ninguem conclui o pacote: o jogo espera `objsInPacket | objsInAlphaPacket` zerarem (rtWaitForVu1, e um laco
+        // embutido em particleDraw). A apresentacao (60 Hz) faz o papel da conclusao do VU1.
+        static const bool s_noVu1 = std::getenv("PS2X_NO_VU1") != nullptr;
+        if (s_noVu1)
+        {
+            const uint32_t zero = 0;
+            std::memcpy(const_cast<uint8_t *>(rdram) + 0x6F87A0u, &zero, 4);
+            std::memcpy(const_cast<uint8_t *>(rdram) + 0x6F87A4u, &zero, 4);
+        }
+    }
+    if (wotmDrawNative(rdram)) return; // camada nativa (native/wotm_native.hpp): fase lida da RAM, sem VU1/GS
+    const uint32_t root = u32(0x006F87C4u); // world
+    Walker w;
+    if (okAddr(root))
+    {
+        w.src = 0; w.walk(root, 0, 0, 0, 0);                        // mundo
+        uint32_t sky = u32(root + 4);
+        if (okAddr(sky)) { w.src = 3; w.walk(sky, 0, 0, 0, 0); }    // ceu
+    }
+    auto csList = [&](uint32_t head, int src) {                     // listas de _cs ativas (personagens/instancias)
+        uint32_t n = u32(head + 4);
+        for (int guard = 0; okAddr(n) && n != head && guard < 4096; ++guard, n = u32(n + 4))
+        {
+            uint32_t cs = u32(n);
+            if (!okAddr(cs) || !u8(cs + 0xC)) continue;               // drawMe
+            uint32_t ep = u32(cs);
+            if (okAddr(ep)) { w.src = src; w.walk(ep, f32(cs + 0x10), f32(cs + 0x14), f32(cs + 0x18), 0); }
+        }
+    };
+    csList(0x0043A2C0u, 1);   // CsPool::m_activeList
+    csList(0x0043A2E0u, 2);   // CsPool::m_HPActiveList
+
+    if (frame % 300 == 0 && std::getenv("PS2X_STATS"))
+    {
+        std::fprintf(stderr, "[scene] frame %ld currScreen=%u world=%06x visited=%u objetos=%zu (mundo=%u cs=%u hp=%u ceu=%u) | ops: obj=%u grp=%u lod=%u trn=%u rot=%u sw=%u scl=%u\n", frame,
+                     u32(0x006F8464u), root, w.visited, w.pts.size(), w.perSrc[0], w.perSrc[1], w.perSrc[2], w.perSrc[3], w.byOp[0], w.byOp[1], w.byOp[2], w.byOp[3], w.byOp[4], w.byOp[6], w.byOp[30]);
+    }
+
+    const int W = GetScreenWidth(), H = GetScreenHeight();
+    DrawRectangle(0, 0, W, H, Color{10, 12, 20, 255});
+    if (w.pts.empty())
+    {
+        DrawText(okAddr(root) ? "cena: 0 objetos" : "cena: world == null", 12, 12, 20, Color{200, 200, 200, 255});
+        return;
+    }
+    float minx = 1e30f, maxx = -1e30f, minz = 1e30f, maxz = -1e30f;
+    for (const Pt &p : w.pts)
+    {
+        if (!std::isfinite(p.x) || !std::isfinite(p.z) || std::fabs(p.x) > 1e7f || std::fabs(p.z) > 1e7f) continue;
+        minx = std::fmin(minx, p.x); maxx = std::fmax(maxx, p.x);
+        minz = std::fmin(minz, p.z); maxz = std::fmax(maxz, p.z);
+    }
+    if (minx > maxx) return;
+    const float sx = (W - 40.f) / std::fmax(maxx - minx, 1.f), sz = (H - 60.f) / std::fmax(maxz - minz, 1.f);
+    const float s = std::fmin(sx, sz);
+    for (const Pt &p : w.pts)
+    {
+        if (!std::isfinite(p.x) || !std::isfinite(p.z) || std::fabs(p.x) > 1e7f || std::fabs(p.z) > 1e7f) continue;
+        float px = 20.f + (p.x - minx) * s, py = 40.f + (p.z - minz) * s;
+        float rad = std::fmax(1.5f, std::fmin(p.r * s, 14.f));
+        static const Color cols[4] = {Color{90, 200, 255, 255}, Color{255, 220, 80, 255}, Color{120, 255, 120, 255}, Color{170, 170, 170, 255}};
+        DrawCircleLines((int)px, (int)py, rad, cols[p.src & 3]);
+        DrawPixel((int)px, (int)py, Color{255, 255, 255, 255});
+    }
+    char buf[160];
+    std::snprintf(buf, sizeof buf, "cena: %zu obj (mundo %u amarelo=cs %u verde=hp %u cinza=ceu %u) x[%.0f..%.0f] z[%.0f..%.0f]", w.pts.size(), w.perSrc[0], w.perSrc[1], w.perSrc[2], w.perSrc[3], minx, maxx, minz, maxz);
+    DrawText(buf, 10, 10, 16, Color{255, 220, 120, 255});
+}
