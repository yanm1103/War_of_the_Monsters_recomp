#!/bin/sh
# Barra o commit que mistura história com referência ou deixa item feito no TODO.md (tools/doclint.py; regra no CLAUDE.md,
# "Documentação") e o que põe em native/ uma comparação de float que o /fp:fast do runtime torna constante (tools/fplint.py).
# Ligar uma vez por clone: git config core.hooksPath tools/githooks
# Só olha os .md e os fontes de native/ que o commit muda; sem Python, deixa passar.
root=$(git rev-parse --show-toplevel)
py=
for c in python python3; do
    if "$c" -c "import sys" >/dev/null 2>&1; then py=$c; break; fi
done
[ -n "$py" ] || exit 0
if git diff --cached --name-only -- native | grep -q .; then
    "$py" "$root/tools/fplint.py" --staged || exit 1
fi
if git diff --cached --name-only -- '*.md' | grep -q .; then
    "$py" "$root/tools/doclint.py" || exit 1
fi
exit 0
